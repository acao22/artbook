# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
# If you don't have a web app, click the </> icon to add one

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=artsbook.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://artsbook-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=artsbook
VITE_FIREBASE_STORAGE_BUCKET=artsbook.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
